    <releases>
        <release version="1.36.1" date="2026-08-29">
            <description>
                <ul>
                    <li>Improved the design of the login flow, making better use of space on landscape/desktop screens.</li>
                    <li>Tweaked scrolling friction in the editor to make it less slippery.</li>
                    <li>Fixed handling of accounts with unlimited storage quota.</li>
                    <li>Fixed folders not being sorted in the browse page.</li>
                    <li>Fixed parts of the app using a hardcoded Ubuntu font.</li>
                    <li>Fixed non-Latin language fonts and inconsistent UI elements in Flathub screenshots.</li>
                </ul>
            </description>
        </release>
        <release version="1.36.0" date="2026-08-20">
            <description>
                <ul>
                    <li>Fixed janky animation when opening and closing the sidebar.</li>
                    <li>Added indent guides to the file tree in the sidebar.</li>
                    <li>Added Linux support for stylus pressure detection.</li>
                    <li>Switched to the new Impeller rendering engine, resulting in fewer frame drops and smoother animations. At present, some graphics may be pixellated/aliased.</li>
                </ul>
            </description>
        </release>
        <release version="1.35.1" date="2026-08-12">
            <description>
                <ul>
                    <li>Reduced RAM consumption by reducing unnecessary threads</li>
                    <li>Miscellaneous fixes from dependencies</li>
                </ul>
            </description>
        </release>
        <release version="1.35.0" date="2026-07-08">
            <description>
                <ul>
                    <li>The browse page is now sorted alphabetically by default. You can customize the sort with the button at the top.</li>
